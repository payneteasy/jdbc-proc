<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Same as test-mysql-datasource.xml, but the dataSource is wrapped in a
         CountingDataSource that counts Statement.executeUpdate(String) calls.
         Used by ListIteratorCleanupDeferredTest to assert that the List-parameter
         temp-table cleanup is deferred to CloseableIterator.close(). -->

    <bean id="daoMethodInfoFactory" class="com.googlecode.jdbcproc.daofactory.DaoMethodInfoFactory">
      <property name="jdbcTemplate" ref="jdbcTemplate" />
    </bean>

    <bean id="dataSource" class="com.googlecode.jdbcproc.daofactory.it.internal.CountingDataSource">
        <constructor-arg>
            <bean class="org.apache.commons.dbcp2.BasicDataSource" destroy-method="close">
                <property name="driverClassName" value="org.mariadb.jdbc.Driver"/>
                <property name="url" value="jdbc:mariadb://localhost/jdbcprocdb?autoReconnect=false&amp;useMysqlMetadata=true" />
                <property name="username" value="jdbcproc"/>
                <property name="password" value="jdbcproc"/>
                <property name="maxTotal" value="2"/>
                <property name="maxIdle" value="2"/>
                <property name="maxWaitMillis" value="5000"/>
                <property name="validationQuery" value="call create_collections()"/>
            </bean>
        </constructor-arg>
    </bean>

</beans>
